# Copy to .env beside compose.yaml (git-ignored). Secrets live here or in the
# secret store — never in source, never in the image.
# Letters and digits only — it is interpolated into a URL unescaped.
POSTGRES_PASSWORD=change-me
# Absolute, OS-native path for PostgreSQL's data directory — no `~`, no relative
# paths. Laptop: C:/Users/you/leaveimpact/pgdata or /home/you/leaveimpact/pgdata.
# Instance: the gp3 mount, /mnt/pgdata.
PGDATA_HOST=/home/you/leaveimpact/pgdata
